# Agent Course Capstone - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets!

# Service
SERVICE_NAME=agent-course-capstone
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_course

# GitHub API (for external integration)
# Create a fine-grained Personal Access Token at https://github.com/settings/tokens
# Minimum permissions for this lab:
#   - Contents: not required — this flow only uses Issues
#   - Issues: read/write (read for list/get, write for create/close)
#   - Metadata: read (required by GitHub API for token validation)
# One token → one repository → minimum permissions. Avoid classic PAT with 'repo' scope.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_BASE_URL=https://api.github.com

# Model Provider (Week 4 ModelClient)
# Options: ollama, openai, anthropic, etc.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:8b
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=

# Runtime
DEFAULT_MAX_RETRIES=3

# Production Layer modes
# test: ScriptedPlanner with empty calls. No GitHub client, no credentials needed.
# demo: ScriptedPlanner with a real create_issue ToolCall. Requires GITHUB_TOKEN.
RUNNER_MODE=test
GITHUB_OWNER=demo-owner
GITHUB_REPO=demo-repo
DEMO_APPROVE_WRITES=false