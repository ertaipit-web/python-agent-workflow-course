# Agent Course Capstone - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets!

# Service
SERVICE_NAME=agent-course-capstone
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_course

# GitHub API (for external integration)
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (for issues read/write)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_BASE_URL=https://api.github.com

# Model Provider (Week 4 ModelClient)
# Options: ollama, openai, anthropic, etc.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:8b
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=

# Runtime
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT_SECONDS=300
DEFAULT_MAX_RETRIES=2